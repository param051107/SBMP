rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Anyone can create a new registration (from Register page)
      allow create: if true;
      
      // Anyone can read a specific registration if they have its exact ID (for QR pass view)
      allow get: if true;
      
      // Allow all operations since Firebase Auth is removed (reverting to simple mode)
      allow list, update, delete: if true;
    }
    
    match /settings/{document=**} {
      // Legacy settings no longer used
      allow read, write: if false;
    }
  }
}
